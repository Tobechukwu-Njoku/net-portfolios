# Settings for one portfolio site. In a container set these as environment
# variables; for a local `node server.js`, copy this file to .env.
# Never commit .env: it holds a password.

# ── Who the site is for ─────────────────────────────────────────────
SITE_NAME=Your Name
SITE_SLOGAN=Your slogan, short and sweet
ABOUT_BIO=A two or three sentence biography. Where you are based, what you shoot, and what draws you to it.
ABOUT_CITY=City
ABOUT_COUNTRY=Country
# Or one free-text line instead of city + country:
# ABOUT_LOCATION=Somewhere by the sea
# A path inside the photos folder. Empty = first image in photos/about/.
ABOUT_PHOTO=

# ── Social links (full URLs; leave empty to hide) ───────────────────
SOCIAL_INSTAGRAM=
SOCIAL_X=
SOCIAL_FACEBOOK=
SOCIAL_LINKEDIN=
SOCIAL_BEHANCE=
SOCIAL_FLICKR=
SOCIAL_YOUTUBE=
# Just the address:
SOCIAL_EMAIL=

# ── Galleries ───────────────────────────────────────────────────────
# Which galleries to show, in order: featured, fauna, people, landscape, urban, film
GALLERIES=featured,fauna,people,landscape,urban,film
# Rename any gallery or change its tagline, e.g.:
# GALLERY_FAUNA_TITLE=Wildlife
# GALLERY_FAUNA_TAGLINE=Creatures great and small
# true = empty galleries show stand-in photos; false = hide empty galleries
SHOW_PLACEHOLDERS=true
# Small "Placeholder" tag on stand-in photos
MARK_PLACEHOLDERS=true

# ── Contact form ────────────────────────────────────────────────────
# Where messages go:
CONTACT_TO=
# The Gmail account that sends them. GMAIL_APP_PASSWORD is a 16-character
# app password: Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# true when a reverse proxy (Traefik, Pangolin, nginx) is in front
TRUST_PROXY=false

# ── Server ──────────────────────────────────────────────────────────
PORT=8080
# For local runs (the container uses /photos and /config):
PHOTOS_DIR=./photos
